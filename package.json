{
  "name": "darthub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DartHub - modular, server-authoritative multiplayer dart game",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prefixed": "BASE_PATH=/darthub NEXT_DIST_DIR=.next-prefixed next build",
    "check:prefix": "node scripts/check-asset-prefix.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prepare": "git config core.hooksPath .husky || echo 'git hooks not set (git unavailable or not a repository)'",
    "realtime": "tsx src/realtime/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
