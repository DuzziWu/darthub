exports[`Lobby Page > matches snapshot structure 1`] = `"<main class="min-h-screen bg-slate-900 text-slate-100 p-4 md:p-8"><div class="max-w-4xl mx-auto space-y-6"><h1 class="text-2xl md:text-3xl font-bold">Game Lobby</h1><section class="bg-slate-800 rounded-lg p-4"><h2 class="text-lg font-semibold mb-2">Matchmaking</h2><button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition-colors">Find Match</button></section><section class="bg-slate-800 rounded-lg p-4"><h2 class="text-lg font-semibold mb-2">Public Rooms</h2><div class="text-slate-400 text-sm">No rooms available</div></section><section class="bg-slate-800 rounded-lg p-4"><h2 class="text-lg font-semibold mb-2">Private Room</h2><button class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition-colors">Create Room</button></section></div></main>"`;
