# DartHub environment variables template
#
# Copy this file to `.env` and replace every placeholder with a real value:
#     cp .env.example .env
# Never commit real secrets — `.env` is ignored by git, this template is not.
# Placeholders marked "change-me" are deliberately insecure; always replace them.
#
# ---------------------------------------------------------------------------
# How to generate a secret
# ---------------------------------------------------------------------------
# The session secret is the one secret the application cannot do without.
# Generate one with:
#
#     openssl rand -base64 32
#
# It signs every session token (src/auth/session.ts). Two properties matter:
# it must be at least 32 characters long, and it must be different on every
# deployment — a secret that two installations share lets a session token
# from one be replayed against the other. The application refuses the
# placeholder from this file, so a deployment that copied the template
# unchanged fails loudly instead of running with a published secret.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Connection string used by Prisma (`prisma/schema.prisma`). Use this when
# running `npm run dev` against a locally installed PostgreSQL server.
# Inside Docker Compose the app service builds DATABASE_URL automatically
# from the POSTGRES_* variables below, so you only need this for native use.
DATABASE_URL=postgresql://darthub:change-me-strong-random@localhost:5432/darthub

# ---------------------------------------------------------------------------
# Docker Compose / PostgreSQL
# ---------------------------------------------------------------------------
# Username for the postgres:16 container started by `docker compose up`.
# POSTGRES_USER=darthub
# Name of the application database created inside the postgres container.
# POSTGRES_DB=darthub
# REQUIRED by docker-compose.yml (it fails fast without it). Must match the
# password embedded in DATABASE_URL above.
POSTGRES_PASSWORD=change-me-strong-random

# ---------------------------------------------------------------------------
# Auth / session signing secret
# ---------------------------------------------------------------------------
# Signs and verifies the session tokens (src/auth/session.ts). This is the
# one and only name of the secret: the code reads AUTH_SECRET and nothing
# else. The older JWT_SECRET name is gone — no code ever read it, and two
# names for one secret only invite the two to drift apart.
#
# Generate a real value with `openssl rand -base64 32` and keep it out of
# the repository. The value below is a placeholder: the application refuses
# it, so an unchanged copy of this file fails at the first sign-in instead
# of running with a published secret.
AUTH_SECRET=change-me-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# Redis (optional for a native run, required in Docker Compose)
# ---------------------------------------------------------------------------
# The counter store of the rate limiter (src/security). With this variable
# set, the counters live in Redis and are shared by every instance of the
# application.
#
# A PRODUCTION installation needs it. The standalone server sets
# NODE_ENV=production, and a production run without a counter store refuses
# every rate-limited request with a 503 — the limits are never silently
# weakened in production. A development run without it counts in the
# process instead, which is enough for one developer.
#
# Docker Compose sets this for you; the redis service runs beside the app.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Server ports
# ---------------------------------------------------------------------------
# Port the Next.js app listens on (matches the Dockerfile and the
# 3000:3000 mapping in docker-compose.yml).
PORT=3000
# Optional: port for the realtime Socket.IO server (src/realtime, default 4000).
# REALTIME_PORT=4000

# ---------------------------------------------------------------------------
# Path prefix (build time)
# ---------------------------------------------------------------------------
# NOT read at runtime. It is read when the config is loaded, so it must be
# set for the build: `BASE_PATH=/darthub npm run build`.
#
# Set it when the app is published under a path prefix, for example behind
# Tailscale Serve at https://<host>.<tailnet>.ts.net/darthub. It moves the
# asset URLs under the prefix and makes the app build its own links with it.
# The prefix must match the mount point the proxy serves.
#
# Leave it unset for a normal run: the app is then served from the root, as
# a local development run on http://localhost:3000 expects.
# BASE_PATH=/darthub
