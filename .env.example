# DartHub environment variables template
#
# Copy this file to `.env` and replace every placeholder with a real value:
#     cp .env.example .env
# Never commit real secrets — `.env` is ignored by git, this template is not.
# Placeholders marked "change-me" are deliberately insecure; always replace them.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Connection string used by Prisma (`prisma/schema.prisma`). Use this when
# running `npm run dev` against a locally installed PostgreSQL server.
# Inside Docker Compose the app service builds DATABASE_URL automatically
# from the POSTGRES_* variables below, so you only need this for native use.
DATABASE_URL=postgresql://darthub:change-me-strong-random@localhost:5432/darthub

# ---------------------------------------------------------------------------
# Docker Compose / PostgreSQL
# ---------------------------------------------------------------------------
# Username for the postgres:16 container started by `docker compose up`.
# POSTGRES_USER=darthub
# Name of the application database created inside the postgres container.
# POSTGRES_DB=darthub
# REQUIRED by docker-compose.yml (it fails fast without it). Must match the
# password embedded in DATABASE_URL above.
POSTGRES_PASSWORD=change-me-strong-random

# ---------------------------------------------------------------------------
# Auth / session signing secret
# ---------------------------------------------------------------------------
# Strong random string used to sign and verify session tokens. Generate one:
#     openssl rand -base64 32
# The auth code (src/auth/sessionCore.ts) reads AUTH_SECRET; JWT_SECRET is
# the same shared secret under the generic task-naming convention. Set both
# to the identical value.
JWT_SECRET=change-me-strong-random
# Same shared secret consumed by the auth code under its canonical name.
AUTH_SECRET=change-me-strong-random

# ---------------------------------------------------------------------------
# Redis (optional)
# ---------------------------------------------------------------------------
# NOT required to run the app. Only needed for optional Redis-backed
# features such as matchmaking persistence. Uncomment to enable.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Server ports
# ---------------------------------------------------------------------------
# Port the Next.js app listens on (matches the Dockerfile and the
# 3000:3000 mapping in docker-compose.yml).
PORT=3000
# Optional: port for the realtime Socket.IO server (src/realtime, default 4000).
# REALTIME_PORT=4000

# ---------------------------------------------------------------------------
# Path prefix (build time)
# ---------------------------------------------------------------------------
# NOT read at runtime. It is read when the config is loaded, so it must be
# set for the build: `BASE_PATH=/darthub npm run build`.
#
# Set it when the app is published under a path prefix, for example behind
# Tailscale Serve at https://<host>.<tailnet>.ts.net/darthub. It moves the
# asset URLs under the prefix and makes the app build its own links with it.
# The prefix must match the mount point the proxy serves.
#
# Leave it unset for a normal run: the app is then served from the root, as
# a local development run on http://localhost:3000 expects.
# BASE_PATH=/darthub
